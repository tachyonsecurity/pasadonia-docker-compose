# Copy this file to `.env` and replace every <placeholder> with a real value:
#   cp example.env .env
# Do NOT commit your filled-in .env — it contains secrets (.gitignore excludes it).

# Place any hex string
LOCAL_WORKER_SECRET=wg-sk-<your-secret-string>

# ============================================
# Redis
# ============================================
REDIS_URL="redis://redis:6379"
# Use "redis://redis:6379" if pasadonia is inside same container network
# Use "redis://localhost:6379" if running on host

# ============================================
# Postgres (Supertokens auth)
# ============================================
POSTGRES_USER=supertokens_user
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=supertokens
POSTGRES_HOST=db
# Use "db" if using Docker Compose, "127.0.0.1" for local development
POSTGRES_PORT=5432

# ============================================
# MongoDB
# ============================================
mongodbURL="mongodb://mongo:27017/test"
# Use "mongodb://mongo:27017/test" inside container network
# Use "mongodb://127.0.0.1:27018/test" for local development
agendaMongodbURL="mongodb://mongo:27017/test"
# Use "mongodb://mongo:27017/test" inside container network
# Use "mongodb://127.0.0.1/test" for local development
dbName="test"

# ============================================
# Service URLs and Ports
# ============================================
frontendBaseURL="http://pasadonia.local.com:3000"
APIGatewayURL="http://pasadonia.local.com:9001"
serverBaseURL="http://pasadonia.local.com:9002"
server2BaseURL="http://pasadonia.local.com:9003"
server3BaseURL="http://pasadonia.local.com:9004"
server4BaseURL="http://pasadonia.local.com:9005"
server5BaseURL="http://pasadonia.local.com:9006"
alertServiceBaseURL="http://pasadonia.local.com:9008"
wsPort=9007
wsURL="ws://pasadonia.local.com:9007"
supertokensAPIDomain=".local.com"
RabbitMQURL="amqp://rabbitmq:5672"
# Use "amqp://rabbitmq:5672" inside container network
# Use "amqp://localhost:5672" for local development

# ============================================
# Supertokens
# ============================================
supertokensService="self hosted"
# "self hosted" or "managed service"
supertokensURI="http://supertokens:3567"
# Use "http://supertokens:3567" inside container network
# Use "http://localhost:3567" for local development
fakePassword=<your-fake-password>

# ============================================
# Websocket
# ============================================
jwtSecretKey=<your-jwt-secret-key>

# ============================================
# Encryption
# ============================================
cryptoSecretKey=<your-crypto-secret-key>

# ============================================
# Portal
# ============================================
CUSTOMER_PORTAL_API_URL=""https://api.pasadonia.com""
